# ── Polymarket ──────────────────────────────────────────────────────────────
# Public endpoints work without credentials.
# Trading requires CLOB API credentials (derive via Polymarket SDK or wallet).
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_SECRET=
POLYMARKET_CLOB_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_USE_DEMO=false

# ── Kalshi ──────────────────────────────────────────────────────────────────
# Public market data works without credentials.
# Trading requires API Key ID + RSA private key from kalshi.com/account/profile
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Or inline PEM (use path OR inline, not both)
KALSHI_PRIVATE_KEY_PEM=
KALSHI_USE_DEMO=true

# ── Robinhood (Partner OAuth — requires approved partner access) ────────────
# Apply at https://go.robinhood.com/partner
ROBINHOOD_CLIENT_ID=
ROBINHOOD_CLIENT_SECRET=
ROBINHOOD_REDIRECT_URI=http://localhost:8080/callback
ROBINHOOD_ACCESS_TOKEN=
ROBINHOOD_REFRESH_TOKEN=
ROBINHOOD_USE_SANDBOX=true

# ── Server ──────────────────────────────────────────────────────────────────
MARKET_AGENT_API_HOST=0.0.0.0
MARKET_AGENT_API_PORT=8000

# ── AI Trading Engine ───────────────────────────────────────────────────────
# OpenAI-compatible API key for advanced LLM trading decisions (optional — rules engine used if empty)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Optional: Finnhub for richer news (free tier at https://finnhub.io)
AI_FINNHUB_API_KEY=

# Risk controls (IMPORTANT — keep dry_run=true until you're ready for live trades)
AI_DRY_RUN=true
AI_REQUIRE_CONFIRMATION=true
AI_MIN_CONFIDENCE=0.65
AI_MAX_POSITION_USD=1000
AI_MAX_SINGLE_TRADE_USD=500

# Paper trading sandbox (works without any broker credentials)
AI_PAPER_PORTFOLIO_PATH=paper_portfolio.json
AI_PAPER_STARTING_CASH=10000

# Default watchlist for automated trading cycles
AI_WATCHLIST=AAPL,MSFT,GOOGL,NVDA,TSLA

# ── Live Growth Trading (multi-platform) ────────────────────────────────────
# YOUR starting capital — money you deposit in YOUR broker accounts
GROWTH_STARTING_CAPITAL=1000

# Growth targets: 2 = double, 3 = triple (comma-separated multipliers)
GROWTH_TARGETS=2,3

# How to split capital across platforms (must sum to 1.0)
GROWTH_ALLOC_ROBINHOOD=0.50
GROWTH_ALLOC_KALSHI=0.30
GROWTH_ALLOC_POLYMARKET=0.20

# LIVE TRADING — both required to execute real money trades
GROWTH_LIVE_ENABLED=false
GROWTH_LIVE_ACK=

# Also set for live execution:
# AI_DRY_RUN=false
# AI_REQUIRE_CONFIRMATION=false
# KALSHI_USE_DEMO=false

# Risk limits (live trading halts if exceeded)
GROWTH_RISK_PER_TRADE_PCT=0.03
GROWTH_MAX_POSITION_PCT=0.15
GROWTH_MAX_DRAWDOWN_PCT=20
GROWTH_MAX_DAILY_LOSS_PCT=10

# Auto-trader daemon: run cycle every N minutes
GROWTH_CYCLE_INTERVAL_MIN=30

# ── Telegram / Discord Bots ─────────────────────────────────────────────────
# Create bots via @BotFather (Telegram) or Discord Developer Portal
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Restrict who can use the bot (comma-separated user IDs). Leave empty = anyone.
# Get your ID: send /start on Telegram or @mention the Discord bot
BOT_ALLOWED_USERS=
